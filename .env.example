# Общие настройки проекта
PROJECT_NAME="Horse Dataset Studio API"

# База данных: SQLite или PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./horse_dataset.db

# Для PostgreSQL:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_NAME=horse_db

# Секретный ключ JWT
SECRET_KEY=change_this_to_a_secure_random_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Начальный администратор
FIRST_SUPERUSER_EMAIL=admin@vim.ru
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_NAME=Admin

# Yandex Object Storage: статический ключ сервисного аккаунта, не IAM/OAuth token.
# Бакет должен быть приватным до загрузки оригиналов.
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=horse-dataset-vim
S3_REGION=ru-central1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
S3_MAX_FILE_SIZE=104857600
S3_UPLOAD_EXPIRES_SECONDS=900
S3_DOWNLOAD_EXPIRES_SECONDS=300
S3_OPERATION_LEASE_SECONDS=600
