# Local-only S1 profile. Copy to .env.s1; keep the existing .env unchanged.
DATABASE_URL=postgresql+asyncpg://platform_app:local-platform-password@127.0.0.1:15432/horse_s1
MIGRATION_DATABASE_URL=postgresql+asyncpg://platform_owner:local-owner-password@127.0.0.1:15432/horse_s1
SECRET_KEY=s1-local-jwt-secret-change-me-before-external-use
S1_DEV_MODE=true
S1_SEED_PASSWORD=s1-local-password-change-me
AUTO_CREATE_TABLES=false
ENFORCE_MIGRATIONS=true
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_BUCKET=horse-s1-fixtures
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=horse-s1-local
S3_SECRET_ACCESS_KEY=horse-s1-local-secret-change-me
S3_ADDRESSING_STYLE=path
GO_SERVICE_URL=http://127.0.0.1:8081
GO_SERVICE_TOKEN=s1-local-service-token-change-me
GO_CONNECT_TIMEOUT_SECONDS=5
GO_READ_TIMEOUT_SECONDS=30
GO_WRITE_TIMEOUT_SECONDS=30
GO_POOL_TIMEOUT_SECONDS=5
GO_SNAPSHOT_TIMEOUT_SECONDS=120
GO_MAX_CONNECTIONS=20
