# Общие настройки проекта
PROJECT_NAME="Horse Dataset Studio API"

# База данных: SQLite или PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./horse_dataset.db

# Для PostgreSQL:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_NAME=horse_db

# Секретный ключ JWT
SECRET_KEY=change_this_to_a_secure_random_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Начальный администратор
FIRST_SUPERUSER_EMAIL=admin@vim.ru
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_NAME=Admin

# Локальный MinIO (docker compose up -d); для облака замените endpoint/credentials.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=horse-originals
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=horse-local
S3_SECRET_ACCESS_KEY=horse-local-secret-change-me
S3_ADDRESSING_STYLE=path
S3_MAX_FILE_SIZE=104857600
S3_UPLOAD_EXPIRES_SECONDS=900
S3_DOWNLOAD_EXPIRES_SECONDS=300
S3_OPERATION_LEASE_SECONDS=600
